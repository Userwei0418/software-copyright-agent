{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "软著材料助手",
  "version": "0.1.0",
  "identifier": "com.local.software-copyright-agent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "软著材料助手",
      "width": 1440,
      "height": 900,
      "minWidth": 1080,
      "minHeight": 720,
      "resizable": true
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' http://127.0.0.1:* data:; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/copyright-agent-sidecar"]
  }
}
