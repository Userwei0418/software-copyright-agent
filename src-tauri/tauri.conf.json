{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "软著材料助手",
  "version": "0.1.1",
  "identifier": "com.local.software-copyright-agent",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/build_frontend.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "软著材料助手",
      "width": 1440,
      "height": 900,
      "minWidth": 1080,
      "minHeight": 720,
      "resizable": true
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' http://127.0.0.1:* data: blob:; connect-src 'self' http://127.0.0.1:*; frame-src https://embed.diagrams.net; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/copyright-agent-sidecar"]
  }
}
